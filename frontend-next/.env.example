NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api
NEXT_API_BASE_URL=http://localhost:5000/api

# Optional, server-side only. Leave empty in committed files.
# NEXT_API_BEARER_TOKEN=
# NEXT_API_AUTH_TOKEN=

# Optional. Defaults to true in production and false in development.
# Set to false only for local HTTP production-mode smoke.
# NEXT_AUTH_COOKIE_SECURE=false

# Optional browser-visible tile layer for the route comparison Leaflet preview.
# Leave empty to use the SVG provider-polyline preview only.
# NEXT_PUBLIC_ROUTE_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_ROUTE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
