# ============================================================
# 物流指挥中心 - 后端环境变量示例（开发用）
# 用法：复制为 backend/.env 并按需填入真实值
# ------------------------------------------------------------
# 数据库优先级（与 backend/config.py 保持一致）：
#   POSTGRES_DATABASE_URL  >  DATABASE_URL  >  本地 SQLite 兜底
# 未配置任何数据库 URL 时，自动回退到 data/logistics.db
# ============================================================

# ---- Flask / JWT ----
FLASK_ENV=development
SECRET_KEY=change-me-flask-secret
JWT_SECRET_KEY=change-me-jwt-secret

# ---- 数据库：PostgreSQL（推荐，生产 / 完整功能基准） ----
# 驱动 psycopg2（requirements.txt: psycopg2-binary==2.9.12）
# 生产环境由 docker-compose.prod.yml 从 POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB 自动拼接注入；
# 本地裸跑可直接设置整串：
#   PowerShell: $env:POSTGRES_DATABASE_URL="postgresql://postgres@localhost:5432/logistics_route_system"
POSTGRES_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/logistics_route_system

# ---- 数据库：兜底（仅当上面未设置时生效） ----
# 留空则使用项目内 SQLite：data/logistics.db（轻量演示 / 单测可用，不支持 PostGIS）
# DATABASE_URL=

# ---- 缓存：Redis（可选，未配置则降级运行） ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- ML / AI 路由开关 ----
# 本地无 ML 依赖时建议置 1，避免相关路由导入报错
DISABLE_ML_ROUTES=1

# ---- Gurobi 高级优化（可选） ----
# 不要把 gurobi.lic 内容提交到仓库；这里只配置本机路径。
GUROBI_HOME=D:\Gurobi1300
GRB_LICENSE_FILE=D:\Gurobi1300\win64\bin\gurobi.lic

# ---- 高德地图 ----
AMAP_WEB_KEY=
AMAP_SERVICE_KEY=
# 兼容别名：AMAP_KEY / GAODE_SERVICE_KEY / GAODE_MAP_KEY / GAODE_BACKEND_KEY
# 可选：固定高德 CDN IPv4，规避 Docker DNS/IPv6 抖动
# AMAP_RESTAPI_IPV4=59.82.14.114

# ---- 天地图 ----
TIANDITU_BROWSER_KEY=
TIANDITU_SERVER_KEY=
# 兼容别名：TIANDITU_KEY / TIANDITU_API_KEY / TDT_SERVER_KEY / TDT_KEY
