# ============================================================
# 物流指挥中心 - 生产环境变量示例
# 用法：cp .env.production.example .env.production && chmod 600 .env.production
# 切勿把真实 .env.production / 数据库密码 / API Key 提交到 Git！
# ============================================================
#
# 【数据库双轨机制】
# 这里填【分项】变量 → 供 postgres 容器初始化 + docker-compose.prod.yml 读取；
# compose 会把它们拼成完整连接串并注入 backend 容器：
#   POSTGRES_DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# backend/config.py 优先读取 POSTGRES_DATABASE_URL。
# 本地裸跑（非 compose）则需手动设置 POSTGRES_DATABASE_URL 整串。

# ---- PostgreSQL / PostGIS 分项 ----
POSTGRES_DB=logistics_route_system
POSTGRES_USER=logistics
POSTGRES_PASSWORD=change-me-strong-postgres-password

# ---- Flask / JWT 密钥 ----
SECRET_KEY=change-me-strong-flask-secret
JWT_SECRET_KEY=change-me-strong-jwt-secret

# ---- Gurobi 高级优化（可选）----
# 生产服务器如启用 Gurobi，请挂载/安装本机 license 文件并只配置路径，不提交证书内容。
GUROBI_HOME=/opt/gurobi
GRB_LICENSE_FILE=/opt/gurobi/gurobi.lic

# ---- 地图与外部服务（可选）----
AMAP_WEB_KEY=
AMAP_SERVICE_KEY=
# 兼容别名：后端也会识别 AMAP_KEY / GAODE_SERVICE_KEY / GAODE_MAP_KEY
TIANAPI_KEY=
TIANDITU_BROWSER_KEY=
TIANDITU_SERVER_KEY=
# 兼容别名：后端也会识别 TIANDITU_KEY / TIANDITU_API_KEY / TDT_SERVER_KEY

# 可选：固定高德 CDN IPv4，规避云主机 Docker DNS/IPv6 抖动
AMAP_RESTAPI_IPV4=59.82.14.114
