# Copy this file to .env.production on the server and fill in real values.
# Do not commit .env.production.

POSTGRES_DB=logistics_route_system
POSTGRES_USER=logistics
POSTGRES_PASSWORD=change-me-strong-postgres-password

SECRET_KEY=change-me-strong-flask-secret
JWT_SECRET_KEY=change-me-strong-jwt-secret

# AMap / Tianditu / optional external providers.
AMAP_WEB_KEY=
AMAP_SERVICE_KEY=
TIANAPI_KEY=
TIANDITU_BROWSER_KEY=
TIANDITU_SERVER_KEY=

# Optional: pin AMap IPv4 if Docker DNS/IPv6 stalls on the cloud host.
AMAP_RESTAPI_IPV4=59.82.14.114
